<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.demo.tvplayer"
    android:versionCode="7"
    android:versionName="1.2.3"
    android:sharedUserId="com.demo.shared">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".DemoProvider"
            android:authorities="com.demo.tvplayer.provider;com.demo.tvplayer.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".DemoService"
            android:exported="false"
            android:process=":remote" />

        <receiver android:name=".DemoReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <meta-data android:name="com.demo.channel" android:value="com.demo.tvplayer" />
    </application>
</manifest>
